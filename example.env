# ==========================
# Django
DJANGO_SECRET_KEY=your_dev_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==========================
# Postgres (только Docker: make up). Без POSTGRES_HOST локальный make run работает на SQLite,
# в Docker POSTGRES_HOST=postgres задаёт docker-compose.dev.yml
POSTGRES_DB=tuning_landing
POSTGRES_USER=landing
POSTGRES_PASSWORD=landing

# ==========================
# Администратор, создаётся при старте Docker-окружения
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@local.local

# ==========================
# Timezone
TZ=Europe/Moscow
